{
  "name": "squeekraider-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/manifest.mjs --prepare && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/manifest.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check:export": "node scripts/manifest.mjs --check",
    "test": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
